{
  "name": "chrispa",
  "version": "0.1.0",
  "private": true,
  "description": "ChrisPa Scents and Soaps LTD — e-commerce platform monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:storefront": "npm run dev --workspace apps/storefront",
    "dev:admin": "npm run dev --workspace apps/admin",
    "build:api": "npm run build --workspace apps/api",
    "build:storefront": "npm run build --workspace apps/storefront",
    "build:admin": "npm run build --workspace apps/admin",
    "prisma:generate": "npm run prisma:generate --workspace apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
