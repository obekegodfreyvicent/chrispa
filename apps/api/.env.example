PORT=3000
DATABASE_URL="postgresql://chrispa:chrispa@localhost:5440/chrispa?schema=public"
REDIS_URL="redis://localhost:6380"
JWT_ACCESS_SECRET="change-me-access"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_REFRESH_TTL_DAYS=30
JWT_MFA_CHALLENGE_SECRET="change-me-mfa-challenge"
TOTP_ENCRYPTION_KEY="change-me-totp-key"
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"
# PAY-FR-1 (docs/SRS.md §21) — sandbox/test keys from your Flutterwave
# dashboard (Settings -> API Keys). FLUTTERWAVE_SECRET_HASH is a value YOU
# choose and also enter in the Flutterwave dashboard (Settings -> Webhooks)
# — it's what proves an incoming webhook actually came from Flutterwave.
# Never commit real values here; this file only documents the variable names.
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-change-me"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-change-me"
FLUTTERWAVE_SECRET_HASH="change-me-webhook-hash"
# Registration OTP (docs/SRS.md FR-8.1/FR-9) — real credentials from your own
# providers. Never commit real values here; this file only documents the
# variable names.
# SMTP — any account works (Gmail app password, Zoho, your domain mailbox,
# Mailtrap for local dev testing without sending real email).
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="change-me"
SMTP_PASS="change-me"
SMTP_FROM="ChrisPa Scents and Soaps <no-reply@chrispa.ug>"
# Africa's Talking (Settings -> API Key in your dashboard). AT_USERNAME is
# "sandbox" for their free test environment.
AT_USERNAME="sandbox"
AT_API_KEY="change-me-at-key"
AT_SENDER_ID=""
OTP_TTL_MINUTES=10
# Google Sign-In (FR-8.4/FR-9.4) — OAuth 2.0 Client ID from Google Cloud
# Console (APIs & Services -> Credentials -> Create Credentials -> OAuth
# client ID -> Web application). Add both frontend origins under "Authorized
# JavaScript origins". Only the Client ID is needed server-side — ID token
# verification doesn't use the client secret.
GOOGLE_CLIENT_ID="change-me.apps.googleusercontent.com"
